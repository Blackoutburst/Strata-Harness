diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 555234c..c51cc30 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -20,7 +20,11 @@ android {
         versionCode = 1
         versionName = "1.0"
 
-        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
+        // E2E suite runner: swaps in HiltTestApplication (see HiltInstrumentedRunner) so the
+        // production PhoneApp provider observers do not race instrumentation against system
+        // providers. Production manifest is untouched. Runner arguments (timeouts, filtering) are
+        // owned by the harness adapter, not by the app.
+        testInstrumentationRunner = "tech.primal.attentive_os.phone.HiltInstrumentedRunner"
     }
 
     signingConfigs {
@@ -108,8 +112,19 @@ dependencies {
     testImplementation(libs.junit)
     androidTestImplementation(libs.androidx.junit)
     androidTestImplementation(libs.androidx.espresso.core)
+    androidTestImplementation(libs.androidx.rules)
+    androidTestImplementation(libs.androidx.runner)
+    androidTestImplementation(libs.androidx.uiautomator)
     androidTestImplementation(platform(libs.androidx.compose.bom))
     androidTestImplementation(libs.androidx.ui.test.junit4)
+    androidTestImplementation(libs.hilt.android.testing)
+    kspAndroidTest(libs.dagger.hilt.compiler)
+    // Compose UI test 1.9+: per-interaction checkAccessibility() and the AccessibilityChecks
+    // API (the BOM alone resolves ui-test-junit4 to 1.8.x, which lacks them). Kept in sync with
+    // the compose-bom below; bump together.
+    androidTestImplementation("androidx.compose.ui:ui-test:1.9.0")
+    androidTestImplementation("androidx.compose.ui:ui-test-manifest:1.9.0")
+    debugImplementation("androidx.compose.ui:ui-test-manifest:1.9.0")
     debugImplementation(libs.androidx.ui.tooling)
     debugImplementation(libs.androidx.ui.test.manifest)
 }
