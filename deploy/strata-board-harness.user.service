[Unit]
Description=Strata Board Harness user supervisor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/.local/lib/strata-board-harness
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/strata-board-harness/environment
ExecStart=/usr/bin/python3 -m strata_board_harness --config %h/.config/strata-board-harness/config.json run
Restart=always
RestartSec=10
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
